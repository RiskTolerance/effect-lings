{
	"name": "effect-practice",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A self-checking, streak-tracking daily practice repo for Effect and the JS/TS primitives underneath it. Runs on Bun.",
	"scripts": {
		"start": "bun run.ts today",
		"today": "bun run.ts today",
		"watch": "bun run.ts watch",
		"list": "bun run.ts list",
		"reset": "bun run.ts reset",
		"typecheck": "tsc --noEmit",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "bun test tests",
		"verify": "bun run.ts verify"
	},
	"dependencies": {
		"effect": "4.0.0-beta.86"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"typescript": "^5.9.3"
	}
}
