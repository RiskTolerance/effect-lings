{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"esModuleInterop": true,
		"verbatimModuleSyntax": false,
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": [
		"run.ts",
		"lib/**/*.ts",
		"exercises/**/*.ts",
		"solutions/**/*.ts"
	],
	"exclude": ["node_modules", "examples"]
}
