{
	"name": "sveltekit-effect-example",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A SvelteKit app using Effect in load functions, form actions, and a JSON API route — the same service/layer pattern as the Hono example.",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "bun --bun svelte-kit sync",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"effect": "4.0.0-beta.86"
	},
	"devDependencies": {
		"@risk-tolerance/svelte-adapter-bun": "^1.8.1",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.9.0",
		"vite": "^8.0.0"
	}
}
